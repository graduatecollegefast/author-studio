# ---- Public (bundled into the browser; safe to expose) ----
VITE_SUPABASE_URL=
# Supabase "anon" / publishable key. Row-level security protects all data.
VITE_SUPABASE_ANON_KEY=
# Show a sign-up form on the login page. Leave false for a private, single-author app.
VITE_ALLOW_SIGNUP=false

# ---- Server only (Netlify environment variables; never prefix with VITE_) ----
# Used by Netlify Functions to talk to Supabase as the signed-in user.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Not required in Phase 1. Reserved for background jobs in later phases.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2+ AI configuration
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=
DEFAULT_ANALYSIS_MODEL=
DEFAULT_WRITING_MODEL=
DEFAULT_EDITING_MODEL=
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
